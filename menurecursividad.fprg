        <attribute name="edited" value="RXN0dWRpYW50ZTtUQk5YQ1YxMTQxNDA0Nzg7MjAyNi0wNi0yNjswODowMjo1MCBwLuKAr20uOzE7MTE3NjM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <call expression="Menu"/>
        </body>
    </function>
    <function name="Factorial" type="Integer" variable="Factorial">
        <parameters>
            <parameter name="n" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="Factorial" type="Integer" array="False" size=""/>
            <if expression="n==1">
                <then>
                    <assign variable="Factorial" expression="1"/>
                </then>
                <else>
                    <assign variable="Factorial" expression="n*Factorial(n-1)"/>
                </else>
            </if>
        </body>
    </function>
    <function name="Fibonacci" type="Integer" variable="suma">
        <parameters>
            <parameter name="numero" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="suma, i" type="Integer" array="False" size=""/>
            <if expression="numero &lt;= 1">
                <then>
                    <assign variable="suma" expression="numero"/>
                </then>
                <else>
                    <assign variable="suma" expression="Fibonacci(numero-1)+Fibonacci(numero-2)"/>
                </else>
            </if>
        </body>
    </function>
    <function name="Menu" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Continuar" type="Boolean" array="False" size=""/>
            <declare name="Opcion, Numero, i, Base, Exponente" type="Integer" array="False" size=""/>
            <assign variable="Continuar" expression="True"/>
            <while expression="Continuar">
                <output expression="&quot;==== menu recursividad =====&quot;" newline="True"/>
                <output expression="&quot;1. Fibonacci&quot;" newline="True"/>
                <output expression="&quot;2. Suma de los digitos de un numero&quot;" newline="True"/>
                <output expression="&quot;3. Factorial&quot;" newline="True"/>
                <output expression="&quot;4. Potenciacion&quot;" newline="True"/>
                <output expression="&quot;5. Arbol de 2 ramas&quot;" newline="True"/>
                <output expression="&quot;6. Arbol de mas ramas&quot;" newline="True"/>
                <output expression="&quot;7. Triangulo de Sierpinski&quot;" newline="True"/>
                <output expression="&quot;8. Cuadrado alfombra Sierpinski&quot;" newline="True"/>
                <output expression="&quot;9. Salida&quot;" newline="True"/>
                <input variable="Opcion"/>
                <if expression="Opcion &gt;= 9">
                    <then>
                        <assign variable="Continuar" expression="False"/>
                    </then>
                    <else>
                        <if expression="Opcion == 1">
                            <then>
                                <output expression="&quot;Digite la posicion&quot;" newline="True"/>
                                <input variable="Numero"/>
                                <for variable="i" start="1" end="Numero" direction="inc" step="1">
                                    <output expression="Fibonacci(i) &amp; &quot; - &quot;" newline="False"/>
                                </for>
                                <output expression="&quot;&quot;" newline="True"/>
                            </then>
                            <else>
                                <if expression="Opcion == 2">
                                    <then>
                                        <output expression="&quot;Digite el numero&quot;" newline="True"/>
                                        <input variable="Numero"/>
                                        <output expression="&quot;La suma de los numeros hasta &quot; &amp; Numero &amp; &quot; es igual &quot; &amp; DigitosDeUnNumero(Numero)" newline="True"/>
                                    </then>
                                    <else>
                                        <if expression="Opcion == 3">
                                            <then>
                                                <output expression="&quot;Digite un numero&quot;" newline="True"/>
                                                <input variable="Numero"/>
                                                <output expression="&quot;EL factorial de &quot; &amp; Numero &amp; &quot; es: &quot; &amp; Factorial(Numero)" newline="True"/>
                                            </then>
                                            <else>
                                                <if expression="Opcion == 4">
                                                    <then>
                                                        <output expression="&quot;Digite la base &quot;" newline="True"/>
                                                        <input variable="Base"/>
                                                        <output expression="&quot; Digite el exponente&quot;" newline="True"/>
                                                        <input variable="Exponente"/>
                                                        <output expression="&quot;El resultado de &quot; &amp; Base &amp; &quot; elevado a &quot; &amp; Exponente &amp; &quot; es: &quot; &amp; Potenciacion(Base, Exponente)" newline="True"/>
                                                    </then>
                                                    <else/>
                                                </if>
                                            </else>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
            </while>
        </body>
    </function>
    <function name="Potenciacion" type="None" variable="">
        <parameters>
            <parameter name="B" type="Integer" array="False"/>
            <parameter name="E" type="Integer" array="False"/>
        </parameters>
        <body/>
    </function>
    <function name="DigitosDeUnNumero" type="Integer" variable="suma">
        <parameters>
            <parameter name="n" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="Modulo, Retorno, suma" type="Integer" array="False" size=""/>
            <if expression="n &lt; 10">
                <then>
                    <assign variable="suma" expression="n"/>
                </then>
                <else>
                    <assign variable="suma" expression="n mod(10) + DigitosDeUnNumero(n/10)"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
