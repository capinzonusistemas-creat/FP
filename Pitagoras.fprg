        <attribute name="edited" value="VVNVQVJJTztDQVJMT1M7MjAyNi0wNC0yNDswNjoyNjo1MiBwLuKAr20uOzE7MTA3OTI="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="CatetoA, CatetoB, Hipotenusa" type="Real" array="False" size=""/>
            <output expression="&quot;Cu&#225;l es el valor del CatetoA&quot;" newline="True"/>
            <input variable="CatetoA"/>
            <output expression="&quot;Cu&#225;l es el valor del CatetoB&quot;" newline="True"/>
            <input variable="CatetoB"/>
            <assign variable="Hipotenusa" expression="sqrt(CatetoA^2+CatetoB^2)"/>
            <output expression="&quot;La Hipotenusa es&quot; &amp; Hipotenusa" newline="True"/>
        </body>
    </function>
</flowgorithm>
