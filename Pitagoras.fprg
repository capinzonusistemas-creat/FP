<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Pitagoras"/>
        <attribute name="authors" value="USUARIO"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-24 06:26:52 p.&#8239;m."/>
