<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="area del circulo"/>
        <attribute name="authors" value="USUARIO"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-10 09:27:17 p.&#8239;m."/>
        <attribute name="created" value="VVNVQVJJTztDQVJMT1M7MjAyNi0wNC0xMDswOToxNDo1MyBwLuKAr20uOzEwNjgw"/>
