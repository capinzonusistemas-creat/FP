    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="area, radio, P&#237;" type="Real" array="False" size=""/>
            <input variable="radio"/>
            <assign variable="P&#237;" expression="3.1415"/>
            <assign variable="area" expression="P&#237; * radio * radio"/>
            <output expression="&quot; el area del circulo es: &quot; &amp; area" newline="True"/>
        </body>
    </function>
