<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="area triangulo"/>
        <attribute name="authors" value="USUARIO"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-17 07:50:05 p.&#8239;m."/>
        <attribute name="created" value="VVNVQVJJTztDQVJMT1M7MjAyNi0wNC0xMDswOToyNzozMyBwLuKAr20uOzEwNjgy"/>
        <attribute name="edited" value="VVNVQVJJTztDQVJMT1M7MjAyNi0wNC0xNzswNzo1MDowNSBwLuKAr20uOzY7MTA3OTU="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="TipoHabitacion" type="String" array="False" size=""/>
            <declare name="CantidadDias, SeguroMedico" type="Integer" array="False" size=""/>
            <declare name="CostoBase, Descuento, CostoTotal" type="Real" array="False" size=""/>
            <output expression="&quot;Bienvenidos al Hotel INTEP DEL META&quot;" newline="True"/>
            <output expression="&quot;&#191;Cuantas habitaciones necesita?, Le ofrezco Suite, Aire o Ventilador&quot;" newline="True"/>
            <input variable="TipoHabitacion"/>
            <assign variable="TipoHabitacion" expression="Suite, Aire, Ventilador"/>
            <assign variable="Aire" expression="80000"/>
            <assign variable="Ventilador" expression="60000"/>
            <assign variable="TipoHabitacion" expression="Suite = 120000"/>
            <output expression="&quot;Cuantas noches desea quedarse&quot;" newline="True"/>
            <input variable="CantidadDias"/>
            <assign variable="CostoBase" expression="CantidadDias * TipoHabitacion"/>
            <assign variable="Descuento" expression="CostoBase - 0.10"/>
            <if expression="">
                <then/>
                <else/>
            </if>
        </body>
    </function>
</flowgorithm>
